# Required. Create this in Discord Developer Portal > Bot. Never commit the value.
DISCORD_BOT_TOKEN=

# Optional comma-separated guild IDs. When set, commands sync only to and run only in these guilds.
SAMSARIX_ALLOWED_GUILD_IDS=

# Optional comma-separated role IDs allowed to run status/check. Guild administrators always pass.
SAMSARIX_ALLOWED_ROLE_IDS=

# JSON array, maximum 20. Optional: expected_statuses and a separately named headers_env variable.
# URLs are operator-controlled and may intentionally target private services.
SAMSARIX_HEALTH_ENDPOINTS=[{"name":"API","url":"https://example.com/health","expected_statuses":[200,204]}]

# Optional secret JSON header mapping referenced by one endpoint's headers_env field.
# Header-bearing endpoint URLs must use HTTPS.
# SAMSARIX_ENDPOINT_HEADERS_API={"Authorization":"Bearer replace-me"}

# Bounded network and cache controls.
SAMSARIX_REQUEST_TIMEOUT_SECONDS=5
SAMSARIX_MAX_CONCURRENCY=5
SAMSARIX_CACHE_TTL_SECONDS=15

# Optional proactive incident/recovery alerts. Leave the channel blank to disable background polling.
SAMSARIX_ALERT_CHANNEL_ID=
SAMSARIX_POLL_INTERVAL_SECONDS=60
SAMSARIX_FAILURE_THRESHOLD=2
SAMSARIX_RECOVERY_THRESHOLD=2
SAMSARIX_LOG_LEVEL=INFO
